pipeline {
    agent any
    stages {
        stage('Build') {
            agent any
            environment {
                LOG_LEVEL='INFO',
                RELEASE='1.0'
            }
            steps {
                echo "Building release ${RELEASE} with log level ${LOG_LEVEL}..."
            }
        }
        stage('Test') {
            steps {
                echo "Testing release ${RELEASE}..."
            }
        }
        stage('Deploy') {
            steps {
                script {
                    def ans = input (
                    message: 'Deploy?',
                    ok: 'Do it!',
                    parameters: [
                        string (name: 'TARGET_ENVIRONMENT', defaultValue: 'PROD', description: 'Target deployment environment'),
                        string(name: 'RELEASE', defaultValue: 'PROD', description: 'Put Version of Release')
                        ]
                      )

                     echo "Deploying release ${ans.RELEASE} to environment ${ans.TARGET_ENVIRONMENT}"
            
        }        
    }
}
}
    post {
        always {
             echo 'Prints whether deploy happened or not, success or failure'
        }
    }

}
